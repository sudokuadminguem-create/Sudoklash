{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["@cloudflare/workers-types", "node"],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["env.d.ts", "app", "lib", "hooks", "db", "scripts", "tests", "*.ts"],
  "exclude": ["node_modules", "components/ui", "build"]
}
