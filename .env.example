# Copy to .env; every value is optional.

# Address and port published on the host. Keep 127.0.0.1 behind a reverse proxy.
HOST_BIND=127.0.0.1
HOST_PORT=3000

# Supabase project (public values, built into the browser code). Leave empty to use the
# project configured in lib/supabase-config.ts. Changing them requires a rebuild.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase administrator key for account deletion. Never use a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
